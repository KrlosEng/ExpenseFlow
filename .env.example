# Variables de entorno de ExpenseFlow. Defínelas en tu terminal o en Vercel (la app no lee archivos .env sola).

# Obligatoria en producción. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL (Neon, Supabase...). Vacía = SQLite local (expenseflow.db)
DATABASE_URL=

# Solo si el frontend se sirve desde otro dominio
ALLOWED_ORIGINS=
